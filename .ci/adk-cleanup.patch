   assert validate_node_data(
       _RoundTripInput, content, preserve_content=False
   ) == {'query': 'hello', 'limit': 5}
+
+
+@pytest.mark.parametrize(
+    'failure', [RuntimeError('toolset failed'), asyncio.CancelledError(), None]
+)
+async def test_agent_tool_closes_toolset_on_all_run_exits(failure):
+  """Nested cleanup releases opened toolsets and leaves parent plugins owned."""
+
+  class TrackingToolset(BaseToolset):
+
+    def __init__(self):
+      super().__init__()
+      self.opened = False
+      self.close_calls = 0
+
+    async def get_tools(self, readonly_context=None):
+      self.opened = True
+      if failure is not None:
+        raise failure
+      return []
+
+    async def close(self):
+      self.close_calls += 1
+
+  class ParentPlugin(BasePlugin):
+
+    def __init__(self):
+      super().__init__(name='parent')
+      self.close_calls = 0
+
+    async def close(self):
+      self.close_calls += 1
+
+  toolset = TrackingToolset()
+  plugin = ParentPlugin()
+  agent = Agent(
+      name='nested',
+      model=testing_utils.MockModel.create(responses=['done']),
+      tools=[toolset],
+  )
+  context = ToolContext(
+      await testing_utils.create_invocation_context(agent, plugins=[plugin])
+  )
+  tool = AgentTool(agent=agent)
+  if failure is None:
+    result = await tool.run_async(args={'request': 'go'}, tool_context=context)
+    assert result == {'result': 'done'}
+  else:
+    with pytest.raises(type(failure)) as error:
+      await tool.run_async(args={'request': 'go'}, tool_context=context)
+    assert error.value is failure
+  assert toolset.opened
+  assert toolset.close_calls == 1
+  assert plugin.close_calls == 0
